@model StudyPlanner.Models.Assignment

<h2>Детали задания</h2>

<div>
    <h4>Задание</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Описание</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Предмет</dt>
        <dd class="col-sm-10">@Model.Subject?.Name</dd>

        <dt class="col-sm-2">Статус</dt>
        <dd class="col-sm-10">@Model.Status</dd>

        <dt class="col-sm-2">Приоритет</dt>
        <dd class="col-sm-10">@Model.Priority</dd>

        <dt class="col-sm-2">Дедлайн</dt>
        <dd class="col-sm-10">@Model.Deadline</dd>

        <dt class="col-sm-2">Повторяемость</dt>
        <dd class="col-sm-10">@Model.Recurrence</dd>

        <dt class="col-sm-2">Теги</dt>
        <dd class="col-sm-10">
            @foreach (var tag in Model.AssignmentTags)
            {
                <span>@tag.Tag.Name </span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Редактировать</a> |
    <a asp-action="Index">Назад к списку</a>
</div>